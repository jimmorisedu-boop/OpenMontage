diff --git a/web-app/src/components/OpenMontagePermissionSelector.tsx b/web-app/src/components/OpenMontagePermissionSelector.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b540a9a3ba3b0c77872830bfd62e9d3aba7cf642
--- /dev/null
+++ b/web-app/src/components/OpenMontagePermissionSelector.tsx
@@ -0,0 +1,53 @@
+import { useEffect, useState } from 'react'
+import { ShieldCheck } from 'lucide-react'
+import { Button } from '@/components/ui/button'
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from '@/components/ui/dropdown-menu'
+import { getServiceHub } from '@/hooks/useServiceHub'
+import { OpenMontagePermissionMode, useOpenMontagePermissionStore } from '@/stores/openmontage-permission-store'
+
+const labels: Record<OpenMontagePermissionMode, string> = { auto: 'Auto', confirm: 'Confirm', read_only: 'Read-only' }
+type ToolResult = { content?: Array<{ text?: string }> }
+function parsePayload(result: ToolResult) {
+  const text = result.content?.find((item) => item.text)?.text
+  if (!text) throw new Error('OpenMontage MCP returned no context')
+  const payload = JSON.parse(text)
+  if (!payload.ok || !payload.context) throw new Error(payload.error?.message ?? 'OpenMontage MCP rejected the request')
+  return payload
+}
+export function OpenMontagePermissionSelector({ conversationId }: { conversationId?: string }) {
+  const conversation = useOpenMontagePermissionStore((state) => conversationId ? state.conversations[conversationId] : undefined)
+  const ensure = useOpenMontagePermissionStore((state) => state.ensureConversation)
+  const update = useOpenMontagePermissionStore((state) => state.updateConversation)
+  const [busy, setBusy] = useState(false)
+  useEffect(() => {
+    if (!conversationId) return
+    const state = ensure(conversationId)
+    if (state.context.thread_revision !== 0) return
+    setBusy(true)
+    getServiceHub().mcp().callTool({ serverName: 'OpenMontage', toolName: 'bootstrap_conversation', arguments: {
+      project_id: conversationId, title: 'OpenMontage project', pipeline_type: 'hybrid',
+    }}).then((result) => {
+      const payload = parsePayload(result as ToolResult)
+      update(conversationId, { mode: payload.permission_mode, context: payload.context })
+    }).catch((error) => console.error('OpenMontage bootstrap failed', error)).finally(() => setBusy(false))
+  }, [conversationId, ensure, update])
+  const setMode = async (mode: OpenMontagePermissionMode) => {
+    if (!conversationId || busy) return
+    setBusy(true)
+    try {
+      const payload = parsePayload(await getServiceHub().mcp().callTool({
+        serverName: 'OpenMontage', toolName: 'set_permission_mode', arguments: { mode },
+      }) as ToolResult)
+      update(conversationId, { mode, context: payload.context })
+    } catch (error) { console.error('OpenMontage permission change failed', error) } finally { setBusy(false) }
+  }
+  const mode = conversation?.mode ?? 'confirm'
+  return <DropdownMenu>
+    <DropdownMenuTrigger asChild><Button variant="ghost" size="sm" disabled={!conversationId || busy} className="h-7 gap-1 px-2">
+      <ShieldCheck size={15} /><span className="text-xs">{labels[mode]}</span>
+    </Button></DropdownMenuTrigger>
+    <DropdownMenuContent align="end">{(Object.keys(labels) as OpenMontagePermissionMode[]).map((item) =>
+      <DropdownMenuItem key={item} onClick={() => setMode(item)}>{labels[item]}{item === mode && <span className="ml-auto">✓</span>}</DropdownMenuItem>
+    )}</DropdownMenuContent>
+  </DropdownMenu>
+}

