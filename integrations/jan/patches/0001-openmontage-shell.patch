+export type OpenMontagePermissionMode = 'auto' | 'confirm' | 'read_only'
+export type OpenMontageContext = { conversation_id: string; thread_revision: number; nonce: string }
+type ConversationState = { mode: OpenMontagePermissionMode; context: OpenMontageContext }
+type State = {
+  conversations: Record<string, ConversationState>
+  ensureConversation: (id: string) => ConversationState
+  updateConversation: (id: string, update: Partial<ConversationState>) => void
+  contextFor: (id: string) => OpenMontageContext
+}
+const initial = (id: string): ConversationState => ({
+  mode: 'confirm', context: { conversation_id: id, thread_revision: 0, nonce: `jan-${id}` },
+})
+export const useOpenMontagePermissionStore = create<State>()(persist((set, get) => ({
+  conversations: {},
+  ensureConversation: (id) => {
+    const found = get().conversations[id]
+    if (found) return found
+    const created = initial(id)
+    set((state) => ({ conversations: { ...state.conversations, [id]: created } }))
+    return created
+  },
+  updateConversation: (id, update) => set((state) => ({
+    conversations: { ...state.conversations, [id]: { ...(state.conversations[id] ?? initial(id)), ...update } },
+  })),
+  contextFor: (id) => get().conversations[id]?.context ?? initial(id).context,
+}), {
+  name: 'openmontage-permission-state',
+  storage: createJSONStorage(() => localStorage),
+  partialize: (state) => ({ conversations: state.conversations }),
+}))
+export const openMontageContextFor = (id: string) =>
+  useOpenMontagePermissionStore.getState().contextFor(id)
