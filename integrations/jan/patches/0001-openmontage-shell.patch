diff --git a/src-tauri/src/lib.rs b/src-tauri/src/lib.rs
index f3085be..a442b3f 100644
--- a/src-tauri/src/lib.rs
+++ b/src-tauri/src/lib.rs
@@ -22,0 +23,56 @@ use tokio::sync::Mutex;
+#[cfg(not(feature = "cli"))]
+const OPENMONTAGE_DATA_ROOT_ENV: &str = "OPENMONTAGE_JAN_DATA_ROOT";
+
+#[cfg(not(feature = "cli"))]
+fn portable_data_root_for_executable(executable: &std::path::Path) -> Option<std::path::PathBuf> {
+    executable.parent()?.parent().map(|runtime| runtime.join("jan-data"))
+}
+
+#[cfg(not(feature = "cli"))]
+fn configure_portable_runtime_environment() -> std::io::Result<std::path::PathBuf> {
+    let root = std::env::var_os(OPENMONTAGE_DATA_ROOT_ENV)
+        .filter(|path| !path.is_empty())
+        .map(std::path::PathBuf::from)
+        .or_else(|| {
+            std::env::current_exe()
+                .ok()
+                .and_then(|path| portable_data_root_for_executable(&path))
+        })
+        .ok_or_else(|| std::io::Error::other("failed to resolve portable Jan data root"))?;
+
+    let paths = [
+        (OPENMONTAGE_DATA_ROOT_ENV, root.clone()),
+        ("WEBVIEW2_USER_DATA_FOLDER", root.join("webview2")),
+        ("APPDATA", root.join("appdata")),
+        ("LOCALAPPDATA", root.join("localappdata")),
+        ("TEMP", root.join("temp")),
+        ("TMP", root.join("temp")),
+    ];
+    for (name, path) in paths {
+        std::fs::create_dir_all(&path)?;
+        std::env::set_var(name, path);
+    }
+    Ok(root)
+}
+
+#[cfg(all(test, not(feature = "cli")))]
+mod portable_runtime_tests {
+    use super::portable_data_root_for_executable;
+    use std::path::Path;
+
+    #[test]
+    fn executable_resolves_to_the_sibling_runtime_data_directory() {
+        assert_eq!(
+            portable_data_root_for_executable(Path::new(
+                r"D:\OpenMontage\runtime\jan\Jan.exe"
+            )),
+            Some(Path::new(r"D:\OpenMontage\runtime\jan-data").to_path_buf())
+        );
+    }
+
+    #[test]
+    fn executable_without_two_parent_directories_is_rejected() {
+        assert_eq!(portable_data_root_for_executable(Path::new("Jan.exe")), None);
+    }
+}
+
@@ -199,0 +256,2 @@ pub fn run() {
